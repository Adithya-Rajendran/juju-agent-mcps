# Eval output. Harness, autoscaler and auto-eval runs all write under
# eval/runs/. The auto-eval loop stages its own sweep files with
# `git add -f` (see eval/auto/auto-eval.sh and its runbooks).
eval/runs/

# Local-only (not published): lab runbooks for the private test
# environment and the raw dated eval logs. eval/FINDINGS.md is the
# published summary of those logs.
sandbox/
eval/REPORT.md
eval/MODEL_COMPARE.md

