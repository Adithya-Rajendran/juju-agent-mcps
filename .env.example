# juju-agent-mcps — environment variables.
#
# Template for a real deployment. Nothing loads this file automatically:
# `source` it into your shell, or copy it to ~/.config/juju-ops-mcp.env
# (chmod 600) for the systemd units in deploy/systemd/. Every value is
# commented out, so an unedited copy changes nothing and juju-ops falls back
# to the current controller in your local Juju CLI files
# (~/.local/share/juju/). The test suite does not use this file; it starts
# its own fake controller (tests/fake_juju/).

# ----------------------------------------------------------------------------
# juju-ops — controller connection
# ----------------------------------------------------------------------------

# Option A: connect directly to a controller API endpoint. Values come from
# `juju show-controller --show-password <controller>`. Setting the endpoint
# disables the local CLI fallback, so set all four together.
# JUJU_CONTROLLER_ENDPOINT=<controller-ip>:17070
# JUJU_USERNAME=<user>
# JUJU_PASSWORD=<password>
# JUJU_CACERT=<path to the controller CA PEM file; a PEM literal also works when exported from a shell>

# Option B: use a named controller from your local CLI files
# (~/.local/share/juju/controllers.yaml) instead of the current one.
# Ignored when JUJU_CONTROLLER_ENDPOINT is set.
# JUJU_CONTROLLER=<controller-name>

# ----------------------------------------------------------------------------
# juju-ops — policy + audit
# ----------------------------------------------------------------------------

# Policy YAML: bounds, allowlists, force_dry_run, default_model.
# Default: ./policy/juju-ops.yaml relative to the working directory.
# JUJU_OPS_POLICY=policy/juju-ops.yaml

# Override the policy's default_model without editing the YAML. Must be in
# allowed_models when that list is non-empty.
# JUJU_OPS_DEFAULT_MODEL=<model>

# Append-only JSONL audit log of every mutating tool call. If unset,
# audit records go to stderr. Set JUJU_OPS_AUDIT=off to disable entirely.
# JUJU_OPS_AUDIT_LOG=/var/log/juju-ops/audit.jsonl
# JUJU_OPS_AUDIT=on

# ----------------------------------------------------------------------------
# juju-docs (defaults shown)
# ----------------------------------------------------------------------------

# JUJU_DOCS_BASE=https://documentation.ubuntu.com
# JUJU_DOCS_PROJECT=canonical-juju
# JUJU_DOCS_VERSION=3.6
# JUJU_DOCS_HTTP_TIMEOUT_S=10

# ----------------------------------------------------------------------------
# cos-metrics
# ----------------------------------------------------------------------------

# Policy YAML. Default: ./policy/cos-metrics.yaml relative to the working
# directory.
# COS_METRICS_POLICY=policy/cos-metrics.yaml

# Overrides prometheus.url from the policy.
# COS_PROM_URL=http://<cos-prometheus-host>/cos-prometheus-0

# Prometheus HTTP timeout in seconds (default 30).
# COS_METRICS_TIMEOUT_S=30

# ----------------------------------------------------------------------------
# eval harness + autoscaler (eval/) — model endpoint
# ----------------------------------------------------------------------------

# Any OpenAI-compatible chat-completions API (vLLM, Ollama, llama.cpp server,
# etc.). The harness POSTs to ${EVAL_BASE_URL}/chat/completions, so include
# the version prefix. Required by the eval tools; there is no default.
# For the auto-eval systemd unit (eval/auto/systemd/) put these in
# ~/.config/juju-auto-eval.env instead.
# EVAL_BASE_URL=http://127.0.0.1:11434/v1

# Bearer token, only if the endpoint needs one. When unset no Authorization
# header is sent.
# EVAL_API_KEY=<token>

# Model for a single harness/autoscaler run (default qwen3.6:35b), and the
# space-separated list eval/auto/auto-eval.sh sweeps.
# EVAL_MODEL=qwen3.6:35b
# EVAL_MODELS="gemma4:31b qwen3.6:35b"
